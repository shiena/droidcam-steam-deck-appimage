FROM docker.io/library/almalinux:8

# dnf repos and all build/runtime dependencies for the DroidCam OBS client (a slim OBS Studio
# 27.2 fork built with -DDROIDCAM_OVERRIDE=ON, no browser/CEF, no scripting).
# AlmaLinux 8 (glibc 2.28) is supported until 2029-05-31 and its older glibc makes the binaries
# forward-compatible with the newer SteamOS userland.
# - epel-release: ninja-build, jansson-devel, mbedtls-devel, speexdsp-devel, ccache
# - powertools: assorted -devel headers (CRB on EL9), incl. the droidcam-obs-plugin deps
#   libusbmuxd-devel / libimobiledevice-devel / libplist-devel (turbojpeg is built from source below)
# - RPM Fusion EL8: ffmpeg / ffmpeg-devel / x264-devel
# Baked into the image so the per-build container doesn't pay dnf install cost each time.
RUN dnf -y update \
    && dnf -y install dnf-plugins-core epel-release \
    && dnf config-manager --set-enabled powertools \
    && dnf -y localinstall --nogpgcheck https://download1.rpmfusion.org/free/el/rpmfusion-free-release-8.noarch.rpm \
    && dnf -y groupinstall 'Development Tools' \
    && dnf -y install \
        pkgconf-pkg-config \
        git \
        cmake \
        ninja-build \
        curl \
        zstd \
        fuse \
        fuse-libs \
        qt5-qtbase-devel \
        qt5-qtbase-private-devel \
        qt5-qtsvg-devel \
        qt5-qtx11extras-devel \
        ffmpeg-devel \
        x264-devel \
        mbedtls-devel \
        jansson-devel \
        libcurl-devel \
        speexdsp-devel \
        freetype-devel \
        fontconfig-devel \
        zlib-devel \
        alsa-lib-devel \
        pulseaudio-libs-devel \
        mesa-libGL-devel \
        mesa-libEGL-devel \
        libX11-devel \
        libxcb-devel \
        libXcomposite-devel \
        libXinerama-devel \
        libXrandr-devel \
        libXfixes-devel \
        libxkbcommon-devel \
        libv4l-devel \
        pciutils-devel \
        kernel-headers \
        ccache \
        nasm \
        libusbmuxd-devel \
        libimobiledevice-devel \
        libplist-devel \
    && dnf clean all

# Build libjpeg-turbo from source. AlmaLinux 8 ships turbojpeg 1.5.3 with RHEL's reduced pre-1.4
# API (no tjGetErrorStr2/tjGetErrorCode), which droidcam-obs-plugin's mjpeg decoder needs. Install
# over /usr with the default SONAMEs (libjpeg.so.62 / libturbojpeg.so.0) so it's a drop-in upgrade
# that pkg-config and the linker pick up automatically. (nasm provides the SIMD assembler.)
ARG LIBJPEG_TURBO_VERSION=3.0.4
RUN curl -sSLo /tmp/ljt.tar.gz \
        "https://github.com/libjpeg-turbo/libjpeg-turbo/releases/download/${LIBJPEG_TURBO_VERSION}/libjpeg-turbo-${LIBJPEG_TURBO_VERSION}.tar.gz" \
    && mkdir -p /tmp/ljt-src \
    && tar -xf /tmp/ljt.tar.gz -C /tmp/ljt-src --strip-components=1 \
    && cmake -G Ninja -S /tmp/ljt-src -B /tmp/ljt-build \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib64 \
        -DCMAKE_BUILD_TYPE=Release -DENABLE_STATIC=OFF -Wno-dev \
    && cmake --build /tmp/ljt-build \
    && cmake --install /tmp/ljt-build \
    && rm -rf /tmp/ljt.tar.gz /tmp/ljt-src /tmp/ljt-build

# Pre-download linuxdeploy AppImages and the Qt plugin so each build run can reuse them.
RUN mkdir -p /opt/linuxdeploy \
    && curl -sSLo /opt/linuxdeploy/linuxdeploy-x86_64.AppImage \
        https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage \
    && curl -sSLo /opt/linuxdeploy/linuxdeploy-plugin-appimage-x86_64.AppImage \
        https://github.com/linuxdeploy/linuxdeploy-plugin-appimage/releases/download/continuous/linuxdeploy-plugin-appimage-x86_64.AppImage \
    && curl -sSLo /opt/linuxdeploy/linuxdeploy-plugin-qt-x86_64.AppImage \
        https://github.com/linuxdeploy/linuxdeploy-plugin-qt/releases/download/continuous/linuxdeploy-plugin-qt-x86_64.AppImage \
    && chmod +x /opt/linuxdeploy/linuxdeploy-x86_64.AppImage \
        /opt/linuxdeploy/linuxdeploy-plugin-appimage-x86_64.AppImage \
        /opt/linuxdeploy/linuxdeploy-plugin-qt-x86_64.AppImage
