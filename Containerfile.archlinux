FROM docker.io/library/archlinux:latest

# git is needed by v4l2loopback-build.sh (upstream-clone fallback for the DKMS source). The base
# packages get replaced by the SteamOS-mirrored versions when the build script runs its
# `pacman -S --overwrite='*'` pass. We do NOT pre-install packages that may be missing in older
# SteamOS snapshots (e.g. ccache or v4l2loopback-dkms), because the overwrite step would then fail
# when those package names cannot be resolved in any repo.
RUN pacman -Sy --noconfirm --needed git \
    && pacman -Scc --noconfirm

# Pre-create build user and sudoers entry so the build script can skip these steps
RUN useradd -m builduser \
    && mkdir -p /etc/sudoers.d \
    && echo 'builduser ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/builduser
